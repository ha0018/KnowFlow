# Local demo uses SQLite, inline document jobs and deterministic extractive answers.
SECRET_KEY=local-development-only-change-before-deployment
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
CELERY_TASK_ALWAYS_EAGER=true
# DATABASE_URL=postgres://knowflow:change-me@localhost:5432/knowflow
REDIS_URL=redis://localhost:6379/0

# demo OR compatible (Chat Completions + Embeddings HTTP protocol)
AI_PROVIDER=demo
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
EMBEDDING_PROVIDER=demo
EMBEDDING_MODEL=demo-hash-v1
# Frozen in the initial database schema. A dimension change requires a schema migration.
EMBEDDING_DIMENSIONS=128
MAX_CONCURRENT_RUNS=3

# Independent profiles. Empty values retain AI_* legacy settings. An explicit
# endpoint requires its own key; the legacy key is never forwarded to a new host.
GENERATION_PROVIDER=
GENERATION_BASE_URL=
GENERATION_API_KEY=
GENERATION_MODEL=
GENERATION_AUTH_REQUIRED=true
GENERATION_TOKEN_PARAMETER=max_completion_tokens
GENERATION_TIMEOUT_SECONDS=60
GENERATION_CONTEXT_WINDOW=16384
GENERATION_INPUT_BUDGET=12000
GENERATION_HISTORY_BUDGET=2000
GENERATION_MAX_OUTPUT_TOKENS=800
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_AUTH_REQUIRED=true
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_PROFILE_VERSION=v1
EMBEDDING_TIMEOUT_SECONDS=45
EMBEDDING_MAX_INPUT_TOKENS=8192
MODEL_MAX_RETRIES=2
MODEL_RETRY_MAX_DELAY_SECONDS=2
DEFAULT_TENANT_DAILY_TOKENS=1000000
DEFAULT_USER_DAILY_TOKENS=100000
# Optional configured prices; blank means unknown, never zero-cost inference.
MODEL_PRICE_VERSION=unpriced
GENERATION_INPUT_USD_PER_MILLION=
GENERATION_OUTPUT_USD_PER_MILLION=
EMBEDDING_USD_PER_MILLION=

# S3 retrieval controls. Rules/lexical are transparent local controls, not neural models.
RETRIEVAL_RERANK_ENABLED=false
AGENT_MAX_TOOL_CALLS=4
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_TOTAL_TIMEOUT_SECONDS=60
AGENT_TOKEN_BUDGET=32000
AGENT_EVIDENCE_BYTES=6000
AGENT_OUTPUT_BYTES=16000
PARSER_TIMEOUT_SECONDS=15
PARSER_CPU_SECONDS=10
PARSER_MEMORY_MB=512
PARSER_OUTPUT_BYTES=16777216
CLEANUP_STORAGE_ENABLED=false
CLEANUP_STORAGE_GRACE_DAYS=7
RETRIEVAL_REWRITE_ENABLED=false
RETRIEVAL_VECTOR_INDEX=exact
REWRITE_PROVIDER=rules
RERANKER_PROVIDER=lexical
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=lexical-overlap-v1
RERANKER_AUTH_REQUIRED=true
RERANKER_TIMEOUT_SECONDS=10
RERANKER_MAX_CHARS=2400
RERANKER_MAX_INPUT_TOKENS=64000
RERANKER_USD_PER_MILLION=

S3_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=knowflow-local
S3_SECRET_KEY=change-this-local-secret
S3_BUCKET=knowflow
S3_REGION=us-east-1

# Compose infrastructure: set strong values before use.
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_APP_PASSWORD=change-this-application-password
MINIO_ROOT_USER=knowflow-local
MINIO_ROOT_PASSWORD=change-this-local-secret
# Local HTTP Compose demonstration only. Enable HTTPS and redirect on deployment.
SECURE_SSL_REDIRECT=false
