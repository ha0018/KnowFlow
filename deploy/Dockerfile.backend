FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir uv==0.11.32
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev
COPY backend/ ./
RUN groupadd --system knowflow && useradd --system --gid knowflow knowflow && \
    mkdir -p /app/media /app/staticfiles && chown -R knowflow:knowflow /app
USER knowflow
EXPOSE 8000
CMD ["uv", "run", "--no-sync", "uvicorn", "config.asgi:application", "--host", "0.0.0.0", "--port", "8000"]
