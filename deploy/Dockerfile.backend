FROM python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54
WORKDIR /app
ENV HOME=/home/knowflow UV_CACHE_DIR=/home/knowflow/.cache/uv
RUN pip install --no-cache-dir uv==0.11.32
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev
COPY backend/ ./
RUN groupadd --system knowflow && useradd --system --create-home --gid knowflow knowflow && \
    mkdir -p /app/media /app/staticfiles && chown -R knowflow:knowflow /app /home/knowflow
USER knowflow
RUN uv run --no-sync python -c "import os; assert os.geteuid() != 0"
EXPOSE 8000
CMD ["uv", "run", "--no-sync", "uvicorn", "config.asgi:application", "--host", "0.0.0.0", "--port", "8000"]
